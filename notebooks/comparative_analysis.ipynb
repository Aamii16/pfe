    "# Comparative Analysis: K-means vs Spectral Clustering vs Louvain Method\n",
    "\n",
    "This notebook provides comprehensive comparative analysis of three clustering algorithms with advanced visualizations for methodology research.\n",
    "\n",
    "## Features:\n",
    "- Algorithm performance dashboard with side-by-side comparisons\n",
    "- Evaluation metrics visualization across different datasets\n",
    "- Processing time analysis and performance benchmarking\n",
    "- Quality vs speed trade-off analysis\n",
    "- Interactive comparative visualizations\n",
    "- Strengths and weaknesses analysis for each method"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "imports",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Import required libraries\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "import networkx as nx\n",
    "import cv2\n",
    "\n",
    "# Clustering algorithms\n",
    "from sklearn.cluster import KMeans, SpectralClustering\n",
    "from sklearn.neighbors import kneighbors_graph\n",
    "\n",
    "# Datasets\n",
    "from sklearn.datasets import make_blobs, make_circles, make_moons, make_classification\n",
    "\n",
    "# Evaluation metrics\n",
    "from sklearn.metrics import (\n",
    "    silhouette_score, \n",
    "    adjusted_rand_score, \n",
    "    normalized_mutual_info_score,\n",
    "    calinski_harabasz_score,\n",
    "    davies_bouldin_score\n",
    ")\n",
    "\n",
    "import pandas as pd\n",
    "from tqdm import tqdm\n",
    "import time\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Try to import community detection for Louvain\n",
    "try:\n",
    "    import community as community_louvain\n",
    "    LOUVAIN_AVAILABLE = True\n",
    "except ImportError:\n",
    "    print(\"Installing python-louvain...\")\n",
    "    import subprocess\n",
    "    import sys\n",
    "    subprocess.check_call([sys.executable, \"-m\", \"pip\", \"install\", \"python-louvain\"])\n",
    "    import community as community_louvain\n",
    "    LOUVAIN_AVAILABLE = True\n",
    "\n",
    "# Set style\n",
    "plt.style.use('seaborn-v0_8')\n",
    "sns.set_palette(\"husl\")\n",
    "\n",
    "print(\"All libraries imported successfully!\")\n",
    "print(f\"Louvain method available: {LOUVAIN_AVAILABLE}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "algorithm-implementations",
   "metadata": {},
   "source": [
    "## Algorithm Implementations and Utilities"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "algorithm-classes",
   "metadata": {},
   "outputs": [],
   "source": [
    "class ClusteringComparator:\n",
    "    \"\"\"Unified interface for comparing different clustering algorithms.\"\"\"\n",
    "    \n",
    "    def __init__(self, random_state=42):\n",
    "        self.random_state = random_state\n",
    "        self.results = {}\n",
    "        \n",
    "    def fit_kmeans(self, X, n_clusters=3, **kwargs):\n",
    "        \"\"\"Fit K-means clustering.\"\"\"\n",
    "        start_time = time.time()\n",
    "        \n",
    "        kmeans = KMeans(n_clusters=n_clusters, random_state=self.random_state, \n",
    "                       n_init=10, **kwargs)\n",
    "        labels = kmeans.fit_predict(X)\n",
    "        \n",
    "        processing_time = time.time() - start_time\n",
    "        \n",
    "        self.results['kmeans'] = {\n",
    "            'labels': labels,\n",
    "            'model': kmeans,\n",
    "            'time': processing_time,\n",
    "            'centroids': kmeans.cluster_centers_,\n",
    "            'inertia': kmeans.inertia_\n",
    "        }\n",
    "        \n",
    "        return labels\n",
    "    \n",
    "    def fit_spectral(self, X, n_clusters=3, **kwargs):\n",
    "        \"\"\"Fit Spectral clustering.\"\"\"\n",
    "        start_time = time.time()\n",
    "        \n",
    "        # Default parameters\n",
    "        params = {'gamma': 1.0, 'n_neighbors': 10, 'affinity': 'rbf'}\n",
    "        params.update(kwargs)\n",
    "        \n",
    "        spectral = SpectralClustering(n_clusters=n_clusters, \n",
    "                                     random_state=self.random_state,\n",
    "                                     **params)\n",
    "        labels = spectral.fit_predict(X)\n",
    "        \n",
    "        processing_time = time.time() - start_time\n",
    "        \n",
    "        self.results['spectral'] = {\n",
    "            'labels': labels,\n",
    "            'model': spectral,\n",
    "            'time': processing_time,\n",
    "            'affinity_matrix': spectral.affinity_matrix_\n",
    "        }\n",
    "        \n",
    "        return labels\n",
    "    \n",
    "    def fit_louvain(self, X, resolution=1.0, k_neighbors=10, **kwargs):\n",
    "        \"\"\"Fit Louvain clustering by first creating a graph.\"\"\"\n",
    "        if not LOUVAIN_AVAILABLE:\n",
    "            print(\"Louvain method not available\")\n",
    "            return None\n",
    "            \n",
    "        start_time = time.time()\n",
    "        \n",
    "        # Create graph from data\n",
    "        knn_graph = kneighbors_graph(X, n_neighbors=k_neighbors, mode='connectivity')\n",
    "        # Make symmetric\n",
    "        adjacency = (knn_graph + knn_graph.T) / 2\n",
    "        \n",
    "        # Convert to NetworkX graph\n",
    "        G = nx.from_scipy_sparse_array(adjacency)\n",
    "        \n",
    "        # Apply Louvain\n",
    "        partition = community_louvain.best_partition(G, resolution=resolution,\n",
    "                                                   random_state=self.random_state)\n",
    "        \n",
    "        # Convert to labels array\n",
    "        labels = np.array([partition[i] for i in range(len(X))])\n",
    "        \n",
    "        # Calculate modularity\n",
    "        modularity = community_louvain.modularity(partition, G)\n",
    "        \n",
    "        processing_time = time.time() - start_time\n",
    "        \n",
    "        self.results['louvain'] = {\n",
    "            'labels': labels,\n",
    "            'graph': G,\n",
    "            'partition': partition,\n",
    "            'time': processing_time,\n",
    "            'modularity': modularity\n",
    "        }\n",
    "        \n",
    "        return labels\n",
    "    \n",
    "    def calculate_metrics(self, X, y_true=None):\n",
    "        \"\"\"Calculate comprehensive metrics for all fitted algorithms.\"\"\"\n",
    "        metrics = {}\n",
    "        \n",
    "        for alg_name, result in self.results.items():\n",
    "            labels = result['labels']\n",
    "            \n",
    "            # Basic metrics\n",
    "            metrics[alg_name] = {\n",
    "                'n_clusters': len(np.unique(labels)),\n",
    "                'silhouette': silhouette_score(X, labels),\n",
    "                'calinski_harabasz': calinski_harabasz_score(X, labels),\n",
    "                'davies_bouldin': davies_bouldin_score(X, labels),\n",
    "                'processing_time': result['time']\n",
    "            }\n",
    "            \n",
    "            # Ground truth metrics (if available)\n",
    "            if y_true is not None:\n",
    "                metrics[alg_name]['ari'] = adjusted_rand_score(y_true, labels)\n",
    "                metrics[alg_name]['nmi'] = normalized_mutual_info_score(y_true, labels)\n",
    "            \n",
    "            # Algorithm-specific metrics\n",
    "            if alg_name == 'kmeans':\n",
    "                metrics[alg_name]['inertia'] = result['inertia']\n",
    "            elif alg_name == 'louvain':\n",
    "                metrics[alg_name]['modularity'] = result['modularity']\n",
    "        \n",
    "        return metrics\n",
    "\n",
    "def create_sample_datasets():\n",
    "    \"\"\"Create diverse datasets for testing clustering algorithms.\"\"\"\n",
    "    datasets = []\n",
    "    \n",
    "    # 1. Gaussian blobs (K-means friendly)\n",
    "    X_blobs, y_blobs = make_blobs(n_samples=300, centers=4, cluster_std=1.5, \n",
    "                                 random_state=42, center_box=(-10, 10))\n",
    "    datasets.append((X_blobs, y_blobs, \"Gaussian Blobs\"))\n",
    "    \n",
    "    # 2. Concentric circles (non-convex)\n",
    "    X_circles, y_circles = make_circles(n_samples=300, factor=0.5, noise=0.1, \n",
    "                                       random_state=42)\n",
    "    datasets.append((X_circles, y_circles, \"Concentric Circles\"))\n",
    "    \n",
    "    # 3. Two moons (non-linearly separable)\n",
    "    X_moons, y_moons = make_moons(n_samples=300, noise=0.15, random_state=42)\n",
    "    datasets.append((X_moons, y_moons, \"Two Moons\"))\n",
    "    \n",
    "    # 4. Anisotropic blobs\n",
    "    X_aniso, y_aniso = make_blobs(n_samples=300, centers=3, random_state=42)\n",
    "    transformation = [[0.6, -0.6], [-0.4, 0.8]]\n",
    "    X_aniso = np.dot(X_aniso, transformation)\n",
    "    datasets.append((X_aniso, y_aniso, \"Anisotropic Blobs\"))\n",
    "    \n",
    "    # 5. Varied density\n",
    "    X_varied, y_varied = make_blobs(n_samples=[100, 200, 50], centers=3, \n",
    "                                   cluster_std=[0.5, 1.5, 2.0], random_state=42)\n",
    "    datasets.append((X_varied, y_varied, \"Varied Density\"))\n",
    "    \n",
    "    return datasets\n",
    "\n",
    "print(\"Clustering comparator and dataset utilities defined!\")"
   ]
  },
