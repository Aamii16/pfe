    "def plot_side_by_side_comparison(comparator, X, y_true=None, dataset_name=\"Dataset\"):\n",
    "    \"\"\"Create side-by-side visual comparison of clustering results.\"\"\"\n",
    "    algorithms = list(comparator.results.keys())\n",
    "    n_algs = len(algorithms)\n",
    "    \n",
    "    # Create figure with subplots\n",
    "    fig, axes = plt.subplots(2, max(2, n_algs + 1), figsize=(4 * (n_algs + 1), 8))\n",
    "    if n_algs == 0:\n",
    "        return\n",
    "    \n",
    "    fig.suptitle(f'Clustering Comparison - {dataset_name}', fontsize=16, fontweight='bold')\n",
    "    \n",
    "    # Plot true clusters (if available)\n",
    "    if y_true is not None:\n",
    "        axes[0, 0].scatter(X[:, 0], X[:, 1], c=y_true, cmap='tab10', alpha=0.7, s=30)\n",
    "        axes[0, 0].set_title('True Clusters')\n",
    "        axes[0, 0].set_xlabel('Feature 1')\n",
    "        axes[0, 0].set_ylabel('Feature 2')\n",
    "    else:\n",
    "        axes[0, 0].scatter(X[:, 0], X[:, 1], c='gray', alpha=0.7, s=30)\n",
    "        axes[0, 0].set_title('Original Data')\n",
    "        axes[0, 0].set_xlabel('Feature 1')\n",
    "        axes[0, 0].set_ylabel('Feature 2')\n",
    "    \n",
    "    # Plot clustering results\n",
    "    for i, alg_name in enumerate(algorithms):\n",
    "        result = comparator.results[alg_name]\n",
    "        labels = result['labels']\n",
    "        \n",
    "        col_idx = i + 1\n",
    "        \n",
    "        # Main clustering result\n",
    "        scatter = axes[0, col_idx].scatter(X[:, 0], X[:, 1], c=labels, \n",
    "                                          cmap='tab10', alpha=0.7, s=30)\n",
    "        \n",
    "        # Add centroids for K-means\n",
    "        if alg_name == 'kmeans' and 'centroids' in result:\n",
    "            centroids = result['centroids']\n",
    "            axes[0, col_idx].scatter(centroids[:, 0], centroids[:, 1], \n",
    "                                   marker='x', s=200, linewidths=3, color='black')\n",
    "        \n",
    "        axes[0, col_idx].set_title(f'{alg_name.title()} Clustering')\n",
    "        axes[0, col_idx].set_xlabel('Feature 1')\n",
    "        axes[0, col_idx].set_ylabel('Feature 2')\n",
    "    \n",
    "    # Remove empty subplots in first row\n",
    "    for i in range(n_algs + 1, axes.shape[1]):\n",
    "        fig.delaxes(axes[0, i])\n",
    "    \n",
    "    # Calculate and display metrics\n",
    "    metrics = comparator.calculate_metrics(X, y_true)\n",
    "    \n",
    "    # Metrics comparison plots\n",
    "    metric_names = ['silhouette', 'calinski_harabasz', 'davies_bouldin']\n",
    "    metric_labels = ['Silhouette Score', 'Calinski-Harabasz', 'Davies-Bouldin']\n",
    "    \n",
    "    for i, (metric, label) in enumerate(zip(metric_names, metric_labels)):\n",
    "        if i < axes.shape[1]:\n",
    "            values = [metrics[alg][metric] for alg in algorithms]\n",
    "            colors = plt.cm.Set3(np.linspace(0, 1, len(algorithms)))\n",
    "            \n",
    "            bars = axes[1, i].bar(algorithms, values, color=colors, alpha=0.8)\n",
    "            axes[1, i].set_title(label)\n",
    "            axes[1, i].set_ylabel('Score')\n",
    "            axes[1, i].tick_params(axis='x', rotation=45)\n",
    "            axes[1, i].grid(True, alpha=0.3)\n",
    "            \n",
    "            # Add value labels on bars\n",
    "            for bar, value in zip(bars, values):\n",
    "                axes[1, i].text(bar.get_x() + bar.get_width()/2, bar.get_height() + 0.01,\n",
    "                               f'{value:.3f}', ha='center', va='bottom')\n",
    "    \n",
    "    # Processing time comparison\n",
    "    if axes.shape[1] > 3:\n",
