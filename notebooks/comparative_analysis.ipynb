    "def create_performance_dashboard(comparator, X, y_true=None, dataset_name=\"Dataset\"):\n",
    "    \"\"\"Create comprehensive performance dashboard.\"\"\"\n",
    "    metrics = comparator.calculate_metrics(X, y_true)\n",
    "    \n",
    "    # Create subplots\n",
    "    fig = make_subplots(\n",
    "        rows=3, cols=3,\n",
    "        subplot_titles=[\n",
    "            'Clustering Results', 'Silhouette Scores', 'Processing Times',\n",
    "            'Calinski-Harabasz Index', 'Davies-Bouldin Index', 'Ground Truth Comparison',\n",
    "            'Algorithm-Specific Metrics', 'Quality vs Speed', 'Cluster Count'\n",
    "        ],\n",
    "        specs=[\n",
    "            [{'type': 'scatter'}, {'type': 'bar'}, {'type': 'bar'}],\n",
    "            [{'type': 'bar'}, {'type': 'bar'}, {'type': 'bar'}],\n",
    "            [{'type': 'bar'}, {'type': 'scatter'}, {'type': 'bar'}]\n",
    "        ]\n",
    "    )\n",
    "    \n",
    "    algorithms = list(metrics.keys())\n",
    "    colors = px.colors.qualitative.Set1[:len(algorithms)]\n",
    "    \n",
    "    # 1. Clustering results visualization (first algorithm as example)\n",
    "    if algorithms:\n",
    "        first_alg = algorithms[0]\n",
    "        labels = comparator.results[first_alg]['labels']\n",
    "        \n",
    "        fig.add_trace(\n",
    "            go.Scatter(\n",
    "                x=X[:, 0], y=X[:, 1],\n",
    "                mode='markers',\n",
    "                marker=dict(color=labels, colorscale='Viridis', size=6),\n",
    "                name=f'{first_alg.title()} Result',\n",
    "                showlegend=False\n",
    "            ),\n",
    "            row=1, col=1\n",
    "        )\n",
    "    \n",
    "    # 2. Silhouette scores\n",
    "    silhouette_scores = [metrics[alg]['silhouette'] for alg in algorithms]\n",
    "    fig.add_trace(\n",
    "        go.Bar(\n",
    "            x=algorithms, y=silhouette_scores,\n",
    "            marker_color=colors,\n",
    "            name='Silhouette',\n",
    "            showlegend=False\n",
    "        ),\n",
    "        row=1, col=2\n",
    "    )\n",
    "    \n",
    "    # 3. Processing times\n",
    "    times = [metrics[alg]['processing_time'] for alg in algorithms]\n",
    "    fig.add_trace(\n",
    "        go.Bar(\n",
    "            x=algorithms, y=times,\n",
    "            marker_color=colors,\n",
    "            name='Time',\n",
    "            showlegend=False\n",
    "        ),\n",
    "        row=1, col=3\n",
    "    )\n",
    "    \n",
    "    # 4. Calinski-Harabasz Index (higher is better)\n",
    "    ch_scores = [metrics[alg]['calinski_harabasz'] for alg in algorithms]\n",
    "    fig.add_trace(\n",
    "        go.Bar(\n",
    "            x=algorithms, y=ch_scores,\n",
    "            marker_color=colors,\n",
    "            name='Calinski-Harabasz',\n",
    "            showlegend=False\n",
    "        ),\n",
    "        row=2, col=1\n",
    "    )\n",
    "    \n",
    "    # 5. Davies-Bouldin Index (lower is better)\n",
    "    db_scores = [metrics[alg]['davies_bouldin'] for alg in algorithms]\n",
    "    fig.add_trace(\n",
    "        go.Bar(\n",
    "            x=algorithms, y=db_scores,\n",
    "            marker_color=colors,\n",
    "            name='Davies-Bouldin',\n",
    "            showlegend=False\n",
    "        ),\n",
    "        row=2, col=2\n",
    "    )\n",
    "    \n",
    "    # 6. Ground truth comparison (if available)\n",
    "    if y_true is not None:\n",
    "        ari_scores = [metrics[alg]['ari'] for alg in algorithms]\n",
    "        nmi_scores = [metrics[alg]['nmi'] for alg in algorithms]\n",
    "        \n",
    "        fig.add_trace(\n",
    "            go.Bar(\n",
    "                x=algorithms, y=ari_scores,\n",
    "                marker_color=colors,\n",
    "                name='ARI',\n",
    "                opacity=0.7\n",
    "            ),\n",
    "            row=2, col=3\n",
    "        )\n",
    "        \n",
    "        fig.add_trace(\n",
    "            go.Bar(\n",
    "                x=algorithms, y=nmi_scores,\n",
    "                marker_color=[c.replace('rgb', 'rgba').replace(')', ', 0.5)') for c in colors],\n",
    "                name='NMI'\n",
    "            ),\n",
    "            row=2, col=3\n",
    "        )\n",
    "    \n",
    "    # 7. Algorithm-specific metrics\n",
    "    specific_metrics = []\n",
    "    specific_values = []\n",
    "    specific_algs = []\n",
    "    \n",
    "    for alg in algorithms:\n",
    "        if alg == 'kmeans' and 'inertia' in metrics[alg]:\n",
    "            specific_metrics.append('Inertia')\n",
    "            specific_values.append(metrics[alg]['inertia'])\n",
    "            specific_algs.append(alg)\n",
    "        elif alg == 'louvain' and 'modularity' in metrics[alg]:\n",
    "            specific_metrics.append('Modularity')\n",
    "            specific_values.append(metrics[alg]['modularity'])\n",
    "            specific_algs.append(alg)\n",
    "    \n",
    "    if specific_metrics:\n",
    "        fig.add_trace(\n",
    "            go.Bar(\n",
    "                x=specific_metrics, y=specific_values,\n",
    "                marker_color=['red', 'blue'][:len(specific_metrics)],\n",
    "                name='Specific Metrics',\n",
    "                showlegend=False\n",
    "            ),\n",
    "            row=3, col=1\n",
    "        )\n",
    "    \n",
    "    # 8. Quality vs Speed scatter plot\n",
    "    for i, alg in enumerate(algorithms):\n",
    "        fig.add_trace(\n",
    "            go.Scatter(\n",
    "                x=[metrics[alg]['processing_time']], \n",
    "                y=[metrics[alg]['silhouette']],\n",
    "                mode='markers+text',\n",
    "                marker=dict(size=15, color=colors[i]),\n",
    "                text=[alg.title()],\n",
    "                textposition='top center',\n",
    "                name=alg.title(),\n",
    "                showlegend=False\n",
    "            ),\n",
    "            row=3, col=2\n",
    "        )\n",
    "    \n",
    "    # 9. Cluster count\n",
    "    cluster_counts = [metrics[alg]['n_clusters'] for alg in algorithms]\n",
    "    fig.add_trace(\n",
    "        go.Bar(\n",
    "            x=algorithms, y=cluster_counts,\n",
    "            marker_color=colors,\n",
    "            name='Clusters',\n",
    "            showlegend=False\n",
    "        ),\n",
    "        row=3, col=3\n",
    "    )\n",
    "    \n",
    "    # Update layout\n",
    "    fig.update_layout(\n",
    "        title=f'Clustering Performance Dashboard - {dataset_name}',\n",
    "        height=1000,\n",
    "        showlegend=True\n",
    "    )\n",
    "    \n",
    "    # Update axis labels\n",
    "    fig.update_xaxes(title_text=\"X1\", row=1, col=1)\n",
    "    fig.update_yaxes(title_text=\"X2\", row=1, col=1)\n",
    "    fig.update_yaxes(title_text=\"Score\", row=1, col=2)\n",
    "    fig.update_yaxes(title_text=\"Time (s)\", row=1, col=3)\n",
    "    fig.update_yaxes(title_text=\"Score\", row=2, col=1)\n",
    "    fig.update_yaxes(title_text=\"Score\", row=2, col=2)\n",
    "    fig.update_yaxes(title_text=\"Score\", row=2, col=3)\n",
    "    fig.update_yaxes(title_text=\"Value\", row=3, col=1)\n",
    "    fig.update_xaxes(title_text=\"Time (s)\", row=3, col=2)\n",
    "    fig.update_yaxes(title_text=\"Silhouette\", row=3, col=2)\n",
    "    fig.update_yaxes(title_text=\"Count\", row=3, col=3)\n",
    "    \n",
    "    fig.show()\n",
    "    return fig, metrics\n",
    "\n",
    "print(\"Performance dashboard function defined!\")"
