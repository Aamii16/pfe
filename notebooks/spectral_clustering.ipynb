   "source": [
    "## Spectral vs K-means Comparison"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "comparison-viz",
   "metadata": {},
   "outputs": [],
   "source": [
    "def compare_spectral_kmeans(X, y_true=None, title=\"Spectral vs K-means Comparison\"):\n",
    "    \"\"\"Compare spectral clustering with K-means on the same data.\"\"\"\n",
    "    # Run both algorithms\n",
    "    spectral = EnhancedSpectralClustering(n_clusters=2, random_state=42)\n",
    "    spectral.fit(X)\n",
    "    \n",
    "    kmeans = KMeans(n_clusters=2, random_state=42, n_init=10)\n",
    "    kmeans_labels = kmeans.fit_predict(X)\n",
    "    \n",
    "    # Create comparison plot\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
    "    fig.suptitle(title, fontsize=16, fontweight='bold')\n",
    "    \n",
    "    # Original data\n",
    "    if y_true is not None:\n",
    "        scatter1 = axes[0, 0].scatter(X[:, 0], X[:, 1], c=y_true, \n",
    "                                     cmap='tab10', alpha=0.7, s=50)\n",
    "        axes[0, 0].set_title('True Clusters')\n",
    "    else:\n",
    "        scatter1 = axes[0, 0].scatter(X[:, 0], X[:, 1], alpha=0.7, s=50, color='gray')\n",
    "        axes[0, 0].set_title('Original Data')\n",
    "    axes[0, 0].set_xlabel('Feature 1')\n",
    "    axes[0, 0].set_ylabel('Feature 2')\n",
    "    \n",
    "    # Spectral clustering results\n",
    "    scatter2 = axes[0, 1].scatter(X[:, 0], X[:, 1], c=spectral.labels_, \n",
    "                                 cmap='tab10', alpha=0.7, s=50)\n",
    "    axes[0, 1].set_title('Spectral Clustering')\n",
    "    axes[0, 1].set_xlabel('Feature 1')\n",
    "    axes[0, 1].set_ylabel('Feature 2')\n",
    "    \n",
    "    # K-means results\n",
    "    scatter3 = axes[1, 0].scatter(X[:, 0], X[:, 1], c=kmeans_labels, \n",
    "                                 cmap='tab10', alpha=0.7, s=50)\n",
    "    # Add centroids\n",
    "    axes[1, 0].scatter(kmeans.cluster_centers_[:, 0], kmeans.cluster_centers_[:, 1], \n",
    "                      marker='x', s=200, linewidths=3, color='black')\n",
    "    axes[1, 0].set_title('K-means Clustering')\n",
    "    axes[1, 0].set_xlabel('Feature 1')\n",
    "    axes[1, 0].set_ylabel('Feature 2')\n",
    "    \n",
    "    # Performance comparison\n",
    "    spectral_silhouette = silhouette_score(X, spectral.labels_)\n",
    "    kmeans_silhouette = silhouette_score(X, kmeans_labels)\n",
    "    \n",
    "    metrics = ['Silhouette Score']\n",
    "    spectral_scores = [spectral_silhouette]\n",
    "    kmeans_scores = [kmeans_silhouette]\n",
    "    \n",
    "    if y_true is not None:\n",
    "        spectral_ari = adjusted_rand_score(y_true, spectral.labels_)\n",
    "        kmeans_ari = adjusted_rand_score(y_true, kmeans_labels)\n",
    "        metrics.append('Adjusted Rand Index')\n",
    "        spectral_scores.append(spectral_ari)\n",
    "        kmeans_scores.append(kmeans_ari)\n",
    "    \n",
    "    x = np.arange(len(metrics))\n",
    "    width = 0.35\n",
    "    \n",
    "    axes[1, 1].bar(x - width/2, spectral_scores, width, label='Spectral', alpha=0.8)\n",
    "    axes[1, 1].bar(x + width/2, kmeans_scores, width, label='K-means', alpha=0.8)\n",
    "    \n",
    "    axes[1, 1].set_title('Performance Comparison')\n",
    "    axes[1, 1].set_xlabel('Metrics')\n",
    "    axes[1, 1].set_ylabel('Score')\n",
    "    axes[1, 1].set_xticks(x)\n",
    "    axes[1, 1].set_xticklabels(metrics)\n",
    "    axes[1, 1].legend()\n",
    "    axes[1, 1].grid(True, alpha=0.3)\n",
    "    \n",
    "    # Add score annotations\n",
    "    for i, (spec_score, km_score) in enumerate(zip(spectral_scores, kmeans_scores)):\n",
    "        axes[1, 1].text(i - width/2, spec_score + 0.01, f'{spec_score:.3f}', \n",
    "                       ha='center', va='bottom')\n",
    "        axes[1, 1].text(i + width/2, km_score + 0.01, f'{km_score:.3f}', \n",
    "                       ha='center', va='bottom')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return spectral, kmeans\n",
    "\n",
    "print(\"Comparison functions defined!\")"
   ]
