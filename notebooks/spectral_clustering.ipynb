    "def plot_eigenvalue_analysis(spectral_model, title=\"Eigenvalue Analysis\"):\n",
    "    \"\"\"Comprehensive eigenvalue analysis of the Laplacian matrix.\"\"\"\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
    "    fig.suptitle(title, fontsize=16, fontweight='bold')\n",
    "    \n",
    "    # 1. Eigenvalue spectrum\n",
    "    axes[0, 0].plot(range(len(spectral_model.eigenvalues_)), spectral_model.eigenvalues_, \n",
    "                    marker='o', linewidth=2, markersize=4)\n",
    "    axes[0, 0].set_title('Eigenvalue Spectrum')\n",
    "    axes[0, 0].set_xlabel('Eigenvalue Index')\n",
    "    axes[0, 0].set_ylabel('Eigenvalue')\n",
    "    axes[0, 0].grid(True, alpha=0.3)\n",
    "    \n",
    "    # Highlight spectral gap\n",
    "    if len(spectral_model.eigenvalues_) > spectral_model.n_clusters:\n",
    "        gap_idx = spectral_model.n_clusters\n",
    "        spectral_gap = spectral_model.eigenvalues_[gap_idx] - spectral_model.eigenvalues_[gap_idx-1]\n",
    "        axes[0, 0].axvline(gap_idx, color='red', linestyle='--', \n",
    "                          label=f'Spectral Gap: {spectral_gap:.3f}')\n",
    "        axes[0, 0].legend()\n",
    "    \n",
    "    # 2. First few eigenvalues (zoomed)\n",
    "    n_show = min(20, len(spectral_model.eigenvalues_))\n",
    "    axes[0, 1].bar(range(n_show), spectral_model.eigenvalues_[:n_show], \n",
    "                   color=plt.cm.viridis(np.linspace(0, 1, n_show)))\n",
    "    axes[0, 1].set_title(f'First {n_show} Eigenvalues')\n",
    "    axes[0, 1].set_xlabel('Eigenvalue Index')\n",
    "    axes[0, 1].set_ylabel('Eigenvalue')\n",
    "    axes[0, 1].grid(True, alpha=0.3)\n",
    "    \n",
    "    # 3. Eigenvalue gaps\n",
    "    eigenvalue_gaps = np.diff(spectral_model.eigenvalues_)\n",
    "    axes[1, 0].plot(range(len(eigenvalue_gaps)), eigenvalue_gaps, \n",
    "                    marker='s', linewidth=2, markersize=4, color='orange')\n",
    "    axes[1, 0].set_title('Eigenvalue Gaps')\n",
    "    axes[1, 0].set_xlabel('Gap Index')\n",
    "    axes[1, 0].set_ylabel('Gap Size')\n",
    "    axes[1, 0].grid(True, alpha=0.3)\n",
    "    \n",
    "    # Find largest gaps\n",
    "    if len(eigenvalue_gaps) > 0:\n",
    "        largest_gap_idx = np.argmax(eigenvalue_gaps[:min(10, len(eigenvalue_gaps))])\n",
    "        axes[1, 0].axvline(largest_gap_idx, color='red', linestyle='--', \n",
    "                          label=f'Largest Gap at {largest_gap_idx+1}')\n",
    "        axes[1, 0].legend()\n",
    "    \n",
    "    # 4. Cumulative eigenvalue contribution\n",
    "    cumulative_eigenvals = np.cumsum(spectral_model.eigenvalues_)\n",
    "    total_sum = cumulative_eigenvals[-1]\n",
    "    cumulative_percentage = cumulative_eigenvals / total_sum * 100\n",
    "    \n",
    "    axes[1, 1].plot(range(len(cumulative_percentage)), cumulative_percentage, \n",
    "                    marker='^', linewidth=2, markersize=4, color='purple')\n",
    "    axes[1, 1].set_title('Cumulative Eigenvalue Contribution')\n",
    "    axes[1, 1].set_xlabel('Eigenvalue Index')\n",
    "    axes[1, 1].set_ylabel('Cumulative Percentage')\n",
    "    axes[1, 1].grid(True, alpha=0.3)\n",
    "    \n",
    "    # Mark 90% threshold\n",
    "    idx_90 = np.argmax(cumulative_percentage >= 90)\n",
    "    axes[1, 1].axhline(90, color='red', linestyle='--', alpha=0.7)\n",
    "    axes[1, 1].axvline(idx_90, color='red', linestyle='--', alpha=0.7, \n",
    "                       label=f'90% at index {idx_90}')\n",
    "    axes[1, 1].legend()\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return spectral_model.eigenvalues_, eigenvalue_gaps\n",
    "\n",
    "def plot_eigenvector_analysis(spectral_model, X, n_eigenvectors=4):\n",
    "    \"\"\"Visualize the first few eigenvectors.\"\"\"\n",
    "    n_show = min(n_eigenvectors, spectral_model.n_clusters + 2)\n",
    "    fig, axes = plt.subplots(2, (n_show + 1) // 2, figsize=(15, 8))\n",
    "    if n_show == 1:\n",
    "        axes = [axes]\n",
    "    elif len(axes.shape) == 1:\n",
    "        axes = axes.reshape(1, -1)\n",
    "    \n",
    "    fig.suptitle('Eigenvector Visualization', fontsize=16, fontweight='bold')\n",
    "    \n",
    "    for i in range(n_show):\n",
    "        row, col = i // ((n_show + 1) // 2), i % ((n_show + 1) // 2)\n",
    "        \n",
    "        if row < axes.shape[0] and col < axes.shape[1]:\n",
    "            eigenvector = spectral_model.eigenvectors_[:, i]\n",
    "            \n",
    "            # Scatter plot colored by eigenvector values\n",
    "            scatter = axes[row, col].scatter(X[:, 0], X[:, 1], c=eigenvector, \n",
    "                                           cmap='RdBu_r', alpha=0.7, s=30)\n",
    "            axes[row, col].set_title(f'Eigenvector {i+1}\\n(λ={spectral_model.eigenvalues_[i]:.3f})')\n",
    "            axes[row, col].set_xlabel('Feature 1')\n",
    "            axes[row, col].set_ylabel('Feature 2')\n",
    "            plt.colorbar(scatter, ax=axes[row, col])\n",
    "    \n",
    "    # Remove empty subplots\n",
    "    for i in range(n_show, axes.size):\n",
    "        row, col = i // ((n_show + 1) // 2), i % ((n_show + 1) // 2)\n",
    "        if row < axes.shape[0] and col < axes.shape[1]:\n",
    "            fig.delaxes(axes[row, col])\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "print(\"Eigenvalue analysis functions defined!\")"
