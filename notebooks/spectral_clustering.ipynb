   "metadata": {},
   "outputs": [],
   "source": [
    "# Import required libraries\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import plotly.express as px\n",
    "import plotly.graph_objects as go\n",
    "from plotly.subplots import make_subplots\n",
    "import networkx as nx\n",
    "import cv2\n",
    "from sklearn.cluster import SpectralClustering, KMeans\n",
    "from sklearn.neighbors import kneighbors_graph, NearestNeighbors\n",
    "from sklearn.metrics import pairwise_distances\n",
    "from sklearn.datasets import make_circles, make_moons, make_blobs\n",
    "from sklearn.decomposition import PCA\n",
    "from sklearn.metrics import silhouette_score, adjusted_rand_score\n",
    "from scipy.sparse import csgraph\n",
    "from scipy.spatial.distance import pdist, squareform\n",
    "import pandas as pd\n",
    "from tqdm import tqdm\n",
    "import time\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "# Set style\n",
    "plt.style.use('seaborn-v0_8')\n",
    "sns.set_palette(\"husl\")\n",
    "\n",
    "print(\"All libraries imported successfully!\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "enhanced-spectral-class",
   "metadata": {},
   "source": [
    "## Enhanced Spectral Clustering Implementation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "spectral-class",
   "metadata": {},
   "outputs": [],
   "source": [
    "class EnhancedSpectralClustering:\n",
    "    \"\"\"Enhanced Spectral Clustering with comprehensive tracking and visualization.\"\"\"\n",
    "    \n",
    "    def __init__(self, n_clusters=2, gamma=1.0, n_neighbors=10, \n",
    "                 affinity='rbf', random_state=42):\n",
    "        self.n_clusters = n_clusters\n",
    "        self.gamma = gamma\n",
    "        self.n_neighbors = n_neighbors\n",
    "        self.affinity = affinity\n",
    "        self.random_state = random_state\n",
    "        \n",
    "        # Tracking variables\n",
    "        self.affinity_matrix_ = None\n",
    "        self.laplacian_matrix_ = None\n",
    "        self.eigenvalues_ = None\n",
    "        self.eigenvectors_ = None\n",
    "        self.graph_ = None\n",
    "        \n",
    "    def fit(self, X):\n",
    "        \"\"\"Fit spectral clustering with detailed tracking.\"\"\"\n",
    "        n_samples = X.shape[0]\n",
    "        \n",
    "        # Build affinity matrix\n",
    "        if self.affinity == 'rbf':\n",
    "            # RBF (Gaussian) kernel\n",
    "            pairwise_dists = pairwise_distances(X, squared=True)\n",
    "            self.affinity_matrix_ = np.exp(-self.gamma * pairwise_dists)\n",
    "        elif self.affinity == 'knn':\n",
    "            # K-nearest neighbors graph\n",
    "            knn_graph = kneighbors_graph(X, n_neighbors=self.n_neighbors, \n",
    "                                       mode='connectivity', include_self=False)\n",
    "            self.affinity_matrix_ = 0.5 * (knn_graph + knn_graph.T).toarray()\n",
    "        else:\n",
    "            raise ValueError(f\"Unknown affinity: {self.affinity}\")\n",
    "        \n",
    "        # Build graph for visualization\n",
    "        self.graph_ = nx.from_numpy_array(self.affinity_matrix_)\n",
    "        \n",
    "        # Compute Laplacian matrix\n",
    "        degree_matrix = np.diag(np.sum(self.affinity_matrix_, axis=1))\n",
    "        self.laplacian_matrix_ = degree_matrix - self.affinity_matrix_\n",
    "        \n",
    "        # Normalized Laplacian\n",
    "        degree_sqrt_inv = np.diag(1.0 / np.sqrt(np.sum(self.affinity_matrix_, axis=1) + 1e-8))\n",
    "        normalized_laplacian = degree_sqrt_inv @ self.laplacian_matrix_ @ degree_sqrt_inv\n",
    "        \n",
    "        # Eigendecomposition\n",
    "        eigenvalues, eigenvectors = np.linalg.eigh(normalized_laplacian)\n",
    "        \n",
    "        # Sort by eigenvalues\n",
    "        idx = np.argsort(eigenvalues)\n",
    "        self.eigenvalues_ = eigenvalues[idx]\n",
    "        self.eigenvectors_ = eigenvectors[:, idx]\n",
    "        \n",
    "        # Use first k eigenvectors for clustering\n",
    "        embedding = self.eigenvectors_[:, :self.n_clusters]\n",
    "        \n",
    "        # Apply K-means to embedding\n",
    "        kmeans = KMeans(n_clusters=self.n_clusters, random_state=self.random_state, n_init=10)\n",
    "        self.labels_ = kmeans.fit_predict(embedding)\n",
    "        \n",
    "        return self\n",
    "    \n",
    "    def predict(self, X):\n",
    "        \"\"\"Predict cluster labels for new data (simplified version).\"\"\"\n",
    "        # This is a simplified prediction - in practice, you'd need to\n",
    "        # extend the affinity matrix and recompute embeddings\n",
    "        return self.labels_\n",
    "\n",
    "print(\"Enhanced Spectral Clustering class defined!\")"
   ]
  },
