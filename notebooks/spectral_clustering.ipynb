   "id": "parameter-sensitivity",
   "metadata": {},
   "source": [
    "## Parameter Sensitivity Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "param-sensitivity",
   "metadata": {},
   "outputs": [],
   "source": [
    "def parameter_sensitivity_analysis(X, y_true=None, title=\"Parameter Sensitivity Analysis\"):\n",
    "    \"\"\"Analyze sensitivity to gamma and n_neighbors parameters.\"\"\"\n",
    "    # Parameter ranges\n",
    "    gamma_range = np.logspace(-3, 1, 10)  # 0.001 to 10\n",
    "    neighbors_range = range(5, 31, 5)     # 5 to 30\n",
    "    \n",
    "    # Results storage\n",
    "    results = []\n",
    "    \n",
    "    print(\"Running parameter sensitivity analysis...\")\n",
    "    \n",
    "    # Test gamma sensitivity (RBF affinity)\n",
    "    print(\"Testing gamma sensitivity...\")\n",
    "    for gamma in tqdm(gamma_range):\n",
    "        try:\n",
    "            spectral = EnhancedSpectralClustering(n_clusters=2, gamma=gamma, \n",
    "                                                affinity='rbf', random_state=42)\n",
    "            spectral.fit(X)\n",
    "            \n",
    "            silhouette = silhouette_score(X, spectral.labels_)\n",
    "            ari = adjusted_rand_score(y_true, spectral.labels_) if y_true is not None else 0\n",
    "            \n",
    "            results.append({\n",
    "                'parameter': 'gamma',\n",
    "                'value': gamma,\n",
    "                'silhouette': silhouette,\n",
    "                'ari': ari,\n",
    "                'affinity': 'rbf'\n",
    "            })\n",
    "        except Exception as e:\n",
    "            print(f\"Error with gamma={gamma}: {e}\")\n",
    "    \n",
    "    # Test neighbors sensitivity (KNN affinity)\n",
    "    print(\"Testing neighbors sensitivity...\")\n",
    "    for n_neighbors in tqdm(neighbors_range):\n",
    "        try:\n",
    "            spectral = EnhancedSpectralClustering(n_clusters=2, n_neighbors=n_neighbors, \n",
    "                                                affinity='knn', random_state=42)\n",
    "            spectral.fit(X)\n",
    "            \n",
    "            silhouette = silhouette_score(X, spectral.labels_)\n",
    "            ari = adjusted_rand_score(y_true, spectral.labels_) if y_true is not None else 0\n",
    "            \n",
    "            results.append({\n",
    "                'parameter': 'n_neighbors',\n",
    "                'value': n_neighbors,\n",
    "                'silhouette': silhouette,\n",
    "                'ari': ari,\n",
    "                'affinity': 'knn'\n",
    "            })\n",
    "        except Exception as e:\n",
    "            print(f\"Error with n_neighbors={n_neighbors}: {e}\")\n",
    "    \n",
    "    # Convert to DataFrame\n",
    "    df_results = pd.DataFrame(results)\n",
    "    \n",
    "    # Plot results\n",
    "    fig, axes = plt.subplots(2, 2, figsize=(15, 10))\n",
    "    fig.suptitle(title, fontsize=16, fontweight='bold')\n",
    "    \n",
    "    # Gamma sensitivity - Silhouette score\n",
    "    gamma_results = df_results[df_results['parameter'] == 'gamma']\n",
    "    if not gamma_results.empty:\n",
    "        axes[0, 0].semilogx(gamma_results['value'], gamma_results['silhouette'], \n",
    "                           marker='o', linewidth=2, markersize=6)\n",
    "        axes[0, 0].set_title('Gamma Sensitivity (Silhouette Score)')\n",
    "        axes[0, 0].set_xlabel('Gamma')\n",
    "        axes[0, 0].set_ylabel('Silhouette Score')\n",
    "        axes[0, 0].grid(True, alpha=0.3)\n",
    "    \n",
    "    # Gamma sensitivity - ARI (if true labels available)\n",
    "    if y_true is not None and not gamma_results.empty:\n",
    "        axes[0, 1].semilogx(gamma_results['value'], gamma_results['ari'], \n",
    "                           marker='s', linewidth=2, markersize=6, color='orange')\n",
    "        axes[0, 1].set_title('Gamma Sensitivity (Adjusted Rand Index)')\n",
    "        axes[0, 1].set_xlabel('Gamma')\n",
    "        axes[0, 1].set_ylabel('Adjusted Rand Index')\n",
    "        axes[0, 1].grid(True, alpha=0.3)\n",
    "    else:\n",
    "        axes[0, 1].text(0.5, 0.5, 'No true labels\\navailable for ARI', \n",
    "                       ha='center', va='center', transform=axes[0, 1].transAxes)\n",
    "        axes[0, 1].set_title('ARI - No True Labels')\n",
    "    \n",
    "    # Neighbors sensitivity - Silhouette score\n",
    "    neighbors_results = df_results[df_results['parameter'] == 'n_neighbors']\n",
    "    if not neighbors_results.empty:\n",
    "        axes[1, 0].plot(neighbors_results['value'], neighbors_results['silhouette'], \n",
    "                       marker='^', linewidth=2, markersize=6, color='red')\n",
    "        axes[1, 0].set_title('Neighbors Sensitivity (Silhouette Score)')\n",
    "        axes[1, 0].set_xlabel('Number of Neighbors')\n",
    "        axes[1, 0].set_ylabel('Silhouette Score')\n",
    "        axes[1, 0].grid(True, alpha=0.3)\n",
    "    \n",
    "    # Neighbors sensitivity - ARI\n",
    "    if y_true is not None and not neighbors_results.empty:\n",
    "        axes[1, 1].plot(neighbors_results['value'], neighbors_results['ari'], \n",
    "                       marker='d', linewidth=2, markersize=6, color='purple')\n",
    "        axes[1, 1].set_title('Neighbors Sensitivity (Adjusted Rand Index)')\n",
    "        axes[1, 1].set_xlabel('Number of Neighbors')\n",
    "        axes[1, 1].set_ylabel('Adjusted Rand Index')\n",
    "        axes[1, 1].grid(True, alpha=0.3)\n",
    "    else:\n",
    "        axes[1, 1].text(0.5, 0.5, 'No true labels\\navailable for ARI', \n",
    "                       ha='center', va='center', transform=axes[1, 1].transAxes)\n",
    "        axes[1, 1].set_title('ARI - No True Labels')\n",
    "    \n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "    \n",
    "    return df_results\n",
    "\n",
    "print(\"Parameter sensitivity analysis function defined!\")"
   ]
  },
